{
  "objective": "maximize single-core PyTorch tokens_per_second while preserving the deterministic workload checksum",
  "metric_name": "tokens_per_second",
  "metric_direction": "maximize",
  "source_path": "examples/model-optimize/torch-cpu-target",
  "workspace": {
    "backend": "git_worktree"
  },
  "edit_surface": {
    "allow": [
      "model.py",
      "serving.py"
    ],
    "deny": [
      "benchmark.py",
      "verify.py",
      "single_thread.py",
      "workload.json",
      "cpp_reference/**"
    ]
  },
  "process_verifiers": [
    {
      "name": "torch_cpu_tokens_per_second",
      "role": "ranking_signal",
      "command": [
        "python",
        "benchmark.py"
      ],
      "timeout_seconds": 120
    }
  ],
  "promotion_verifiers": [
    {
      "name": "torch_cpu_correctness",
      "role": "promotion_gate",
      "command": [
        "python",
        "verify.py"
      ],
      "timeout_seconds": 60
    }
  ],
  "budget": {
    "max_parallel": 2
  },
  "strategy": {
    "name": "random",
    "orchestration_mode": "parallel_loops",
    "worker_host": "codex",
    "worker_budget": {
      "max_runtime_seconds": 600,
      "on_exceed": "interrupt"
    },
    "models": [
      {
        "model": "gpt-5.6-terra",
        "count": 1,
        "reasoning_effort": "high"
      },
      {
        "model": "gpt-5.6-sol",
        "count": 1,
        "reasoning_effort": "high"
      }
    ]
  },
  "constraints": {
    "suggested_batch_size": 2,
    "task_summary": "Each fixed worker optimizes model.py or serving.py only. Keep all PyTorch and CPU backend thread counts at one. Read the shared Annotated Evidence before each iteration; it is coordination context, not a reservation mechanism."
  }
}
